# ========================================
*.env
.env.local
.env.*.local
secrets/
credentials/
*.key
*.pem
*.p12

# ========================================
# Arquivos Temporários e Cache
# ========================================
*.tmp
*.temp
*.log
*.cache
.DS_Store
Thumbs.db

# ========================================
# IDEs e Editores
# ========================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ========================================
# Python
# ========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
*.egg-info/
dist/
build/

# ========================================
# Node.js / JavaScript
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm
.yarn/

# ========================================
# Arquivos de Build e Compilação
# ========================================
*.o
*.exe
*.out
*.class
target/
bin/
obj/

# ========================================
# Backups e Versões
# ========================================
*.bak
*.backup
*.old
*-backup/

# ========================================
# Arquivos Grandes (opcional)
# ========================================
# *.zip
# *.tar.gz
# *.rar
# *.7z

# ========================================
# Sistema Operacional
# ========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

