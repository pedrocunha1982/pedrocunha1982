# Amazon Business API Credentials
# Obtenha suas credenciais em: https://developer.amazonservices.com/

# Client ID e Secret do LWA (Login with Amazon)
AMAZON_CLIENT_ID=your_client_id_here
AMAZON_CLIENT_SECRET=your_client_secret_here

# Refresh Token (obtido após autorização OAuth)
AMAZON_REFRESH_TOKEN=your_refresh_token_here

# Marketplace ID (Brasil = A2Q3Y263D00KWC)
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC

# Seller/Buyer ID
AMAZON_SELLER_ID=your_seller_id_here

# Região (na-east-1 para Americas)
AMAZON_REGION=na-east-1

# Para futuras integrações
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=
